<?xml version="1.0" encoding="utf-8"?>
<!-- Projector-only components; merged into the main manifest for the tv flavor. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- XGIMI's public platform library: real battery level (the Android battery service reports none). -->
        <uses-library
            android:name="com.xgimi.api"
            android:required="false" />
        <!-- Started by the stub apps (:stub) when a remote shortcut key is pressed. -->
        <activity
            android:name=".RemoteButtonActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Catches the remote's voice key everywhere and draws the panel over the current app.
             Enabled over adb (settings put secure enabled_accessibility_services ...). -->
        <service
            android:name=".PanelOverlay"
            android:exported="true"
            android:label="Beam: панель"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/panel_overlay" />
        </service>

    </application>
</manifest>
