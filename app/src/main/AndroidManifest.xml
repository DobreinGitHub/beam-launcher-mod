<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Granted over adb (appops GET_USAGE_STATS) to sort tiles by last use. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Watch Next / preview channels from other apps, and their http poster art. -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- Runtime permission, granted over adb: lets us see other apps' non-browsable channels. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <!-- Granted over adb; see AccessibilityGuard. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- App op granted over adb: the screensaver delay (screen_off_timeout). -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Only for MicTestActivity, the remote microphone experiment. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Tiles">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="Beam"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Sleep timer alarms (SleepTimer). -->
        <receiver
            android:name=".SleepTimerReceiver"
            android:exported="false" />

        <receiver
            android:name=".AdbCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver" />

        <!-- Lets Key Mapper (or adb) open the appearance panel from anywhere. -->
        <activity
            android:name=".OpenPanelActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Оформление"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="com.home.tiles.OPEN_PANEL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- XGIMI's public platform library: real battery level (the Android battery service reports none). -->
        <uses-library
            android:name="com.xgimi.api"
            android:required="false" />
        <!-- Receives the speech model zip over adb (content write); shell-only via DUMP. -->
        <provider
            android:name=".VoiceModelProvider"
            android:authorities="com.home.tiles.voicemodel"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- System speech recognition (Vosk) so apps' microphone buttons work; the voice key is push-to-talk. -->
        <service
            android:name=".VoskRecognitionService"
            android:exported="true"
            android:label="Beam: распознавание речи">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>
        <activity
            android:name=".VoiceSearchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
                <action android:name="android.speech.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Diagnostic: records the microphone (does the remote's voice reach apps?). -->
        <activity
            android:name=".MicTestActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Started by the stub apps (:stub) when a remote shortcut key is pressed. -->
        <activity
            android:name=".RemoteButtonActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Catches the remote's voice key everywhere and draws the panel over the current app.
             Enabled over adb (settings put secure enabled_accessibility_services ...). -->
        <service
            android:name=".PanelOverlay"
            android:exported="true"
            android:label="Beam: панель"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/panel_overlay" />
        </service>
    </application>
</manifest>
